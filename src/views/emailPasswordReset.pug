extends _baseEmail

block content
    p Hi #{firstname},
        p Forgot your password...??, no worries, we got you covered 👍🫡
        p Submit a PATCH request with your new password and passwordConfirm at: 
        b #{url} 

        p (Website for this action is not yet implemented)
        table.btn.btn-primary(role='presentation' border='0' cellpadding='0' cellspacing='0')
            tbody
                tr
                    td(align='left')
                        table(role='presentation' border='0' cellpadding='0' cellspacing='0')
                            tbody
                                tr
                                    td
                                        a(href=url target='_blank') Reset your password
        p If you didn't forget your password, then please ignore this email
        p - Akshay Dev, CEO