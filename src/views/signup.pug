extends _base

block content
    main.main
        //- .login-form
        .signup-form
            h2.heading-secondary.ma-bt-lg Create your new account
            form.form
                .form__group
                    label.form__label(for='name') Name
                    input#name.form__input(type='text' name='name' required)
                .form__group
                    label.form__label(for='email') Email address
                    input#email.form__input(type='email' name='name' placeholder='you@example.com' required)
                .form__group.ma-bt-md
                    label.form__label(for='password') Password
                    input#password.form__input(type='password' name='password' placeholder='••••••••' required minlength='8')
                .form__group.ma-bt-lg
                    label.form__label(for='password-confirm') Confirm password
                    input#password-confirm.form__input(type='password' name='passwordConfirm' placeholder='••••••••'  required minlength='8')
                .form__group
                    button.btn.btn--green Signup 