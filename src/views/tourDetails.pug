extends _base

block append head 
  meta( http-equiv="Content-Security-Policy" content="script-src 'self' https://unpkg.com; style-src 'self' https://unpkg.com;")
  link( rel= 'stylesheet' href= 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' )
  script( src= 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' type='module' integrity='sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=' defer='true')
  script( src='/js/mapbox.js' type='module' defer='true')

mixin overviewBox(icon, label, value)
  .overview-box__detail
    svg.overview-box__icon
      use(xlink:href=`/img/icons.svg#icon-${icon}`)
    span.overview-box__label= label
    span.overview-box__text= value

block main 

  section.section-header
    .header__hero
      .header__hero-overlay &nbsp;
      img.header__hero-img(src=`/img/tours/${tour.imageCover}` alt=`${tour.imageCover}`)

    .heading-box
      h1.heading-primary
        span= `${tour.name} Tour`
      .heading-box__group
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-clock')
          span.heading-box__text= `${tour.duration} days`
        .heading-box__detail
          svg.heading-box__icon
            use(xlink:href='/img/icons.svg#icon-map-pin')
          span.heading-box__text= tour.startLocation.description

  section.section-description
    .overview-box
      div
        .overview-box__group
          h2.heading-secondary.ma-bt-lg Quick facts
          +overviewBox('calendar', 'Next Date', tour.startDates[0].toLocaleString('default', {month:'long', year: 'numeric'}))
          +overviewBox('trending-up', 'Difficulty', tour.difficulty)
          +overviewBox('user', 'Participants', `${tour.maxGroupSize} people`)
          +overviewBox('star', 'Rating', `${tour.ratingsAverage} / 5`)

        .overview-box__group
          h2.heading-secondary.ma-bt-lg Your tour guides
          each guide in tour.guides 
            .overview-box__detail
              img.overview-box__img(src=`/img/users/${guide.photo}` alt=`${guide.name}`)
              - if(guide.role === 'guide') guide.role = 'tour-guide' 
              span.overview-box__label= guide.role
              span.overview-box__text= guide.name

    .description-box
      h2.heading-secondary.ma-bt-lg= `About ${tour.name} tour`
      each p in tour.description.split('\n')
        p.description__text= p

  section.section-pictures
    each image, i in tour.images
      .picture-box
        img.picture-box__img(class=`picture-box__img--${i+1}` src=`/img/tours/${image}` alt=`${tour.name} Tour`)

  section.section-map
    #map(data-locations=JSON.stringify(tour.locations))

  section.section-reviews
    .reviews
      each review in tour.reviews
        .reviews__card
          .reviews__avatar
            img.reviews__avatar-img(src=`/img/users/${review.user.photo}` alt=`${review.user.name}`)
            h6.reviews__user= review.user.name
          p.reviews__text= review.description
          .reviews__rating
            each _ in Array.from({ length: review.rating })
              svg.reviews__star.reviews__star--active
                use(xlink:href='/img/icons.svg#icon-star')
            each _ in Array.from({ length: 5-review.rating })
              svg.reviews__star.reviews__star--inactive
                use(xlink:href='/img/icons.svg#icon-star')

  section.section-cta
    .cta
      .cta__img.cta__img--logo
        img(src='/img/logo-white.png' alt='Natours logo')
      img.cta__img.cta__img--1(src=`/img/tours/${tour.images[1]}` alt='Tour image')
      img.cta__img.cta__img--2(src=`/img/tours/${tour.images[2]}` alt='Tour image')
      .cta__content
        h2.heading-secondary What are you waiting for?
        p.cta__text #{tour.duration} days. 1 adventure. Infinite memories. Make it yours today!
        button.btn.btn--green.span-all-rows Book tour now!