{
  "name": "natours",
  "version": "1.0.0",
  "description": "learning Node, Express and MongoDb ",
  "main": "index.js",
  "type": "module",
  "targets": {
    "default": {
      "distDir": "./public"
    }
  },
  "scripts": {
    "start": "nodemon src/server.js",
    "start:prod": "set NODE_ENV=prod&& nodemon src/server.js",
    "debug": "ndb src/server.js",
    "debug:prod": "set NODE_ENV=prod&& ndb src/server.js",
    "watch:js": "parcel watch ./public/js/index.js --dist-dir ./public/ --target default"
  },
  "author": "Akshay",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.15",
    "pug": "^3.0.3",
    "slugify": "^1.6.6",
    "validator": "^13.12.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "parcel": "^2.14.4"
  }
}
